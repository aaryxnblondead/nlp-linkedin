############################################################
# Copy this file to .env and fill in your local dev values #
############################################################

# --- Database (optional for local Docker dev) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password
POSTGRES_DB=qualifyai
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432

# --- CORS / Frontend ---
FRONTEND_ORIGIN=http://localhost:3000
EXTRA_CORS_ORIGINS=

# --- LLM / Generation ---
# Provider for generation: google | hf (huggingface)
GEN_PROVIDER=google
# Google Generative AI (Gemini) (used when GEN_PROVIDER=google)
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_MODEL_ID=gemini-1.5-flash
# Hugging Face (optional local inference; used when GEN_PROVIDER=hf)
HUGGINGFACE_HUB_TOKEN=your_hf_token_here
HF_MODEL_ID=google/gemma-2-2b-it

# Feature flags
USE_GENERATOR=true
CHAT_GROUNDED_ONLY=true
USE_LLM_NAME=true
USE_LLM_SKILLS_ENRICH=true
USE_LLM_SCORING=true
USE_LLM_NER_ENRICH=true
USE_OFFLINE_EMBEDDINGS=true

# NLP / spaCy
SPACY_MODEL=en_core_web_sm
NER_ENRICH_MAX_SNIPPETS=40
NER_ENRICH_MODEL_ID=gemini-1.5-flash

# Storage
USE_FIREBASE=false
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=

# Vector store / skills alias store
CHROMA_DIR=chroma_db
SKILLS_DYNAMIC_PATH=backend/data/skills_dynamic.json

# Worker / Broker
REDIS_URL=redis://localhost:6379/0

# Scraper (optional)
SCRAPER_ENGINE=selenium
USE_LINKEDIN_SCRAPE=false
LINKEDIN_EMAIL=
LINKEDIN_PASSWORD=

# Frontend build
REACT_APP_API_URL=http://localhost:8000/api/v1
