# ===== Production environment variables =====
# Copy to .env.production and fill in secrets before deploying

# --- Database (Postgres) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=12345678
POSTGRES_DB=qualifyai
POSTGRES_SERVER=postgres
POSTGRES_PORT=5432
# Optional single-URL override (recommended for AWS RDS)
# DATABASE_URL=postgresql://user:password@host:5432/dbname
DATABASE_URL=

# --- Redis ---
# Redis is internal-only via Docker network, no external exposure required
REDIS_URL=redis://redis:6379/0

# --- Backend app ---
# Allow same-origin (frontend proxy) and optionally your domain
FRONTEND_ORIGIN=https://your-domain.example
# Additional origins (comma-separated) if you serve frontend elsewhere
EXTRA_CORS_ORIGINS=
# Optional regex to allow subdomains (takes precedence over allow_origins)
# CORS_ORIGIN_REGEX=^https?://(.*\.)?your-domain\.example$

# SPAcy model (downloaded during build/start)
SPACY_MODEL=en_core_web_sm
SPACY_AUTO_DOWNLOAD=false
RUN_MIGRATIONS=true
UVICORN_WORKERS=2
UVICORN_TIMEOUT_KEEP_ALIVE=30

# --- LLM/Embeddings ---
# Google: used for embeddings (required for RAG) and generation when GEN_PROVIDER=google
GOOGLE_API_KEY="your_google_api_key_here"
# Provider for generation: google | transformers (hf)
GEN_PROVIDER=google
# Google model id (if using Google generation)
GEMINI_MODEL_ID=gemini-1.5-flash
# HF token and model (if using transformers)
HF_TOKEN=
HF_MODEL_ID=google/gemma-2-2b-it

# Feature flags
USE_GENERATOR=true
CHAT_GROUNDED_ONLY=true
USE_LLM_NAME=true
USE_LLM_SKILLS_ENRICH=true
USE_LLM_SCORING=true
# Dynamic skills path inside container
SKILLS_DYNAMIC_PATH=backend/data/skills_dynamic.json

# --- Frontend build ---
# For unified origin deployment, set API URL to path and proxy via Nginx to backend
REACT_APP_API_URL=/api/v1

# --- Storage ---
# Where to persist vector store (inside container)
CHROMA_DIR=chroma_db

# Environment mode
APP_ENV=production
